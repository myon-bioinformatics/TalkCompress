{
  "version": 1,
  "title": "TalkCompress agreed conventions (ShorthandEdge / C ledger)",
  "meta": {
    "base_mix": [
      "en",
      "zh",
      "ja"
    ],
    "notes": [
      "Owned by C (ShorthandEdge). Source of truth for first-round agreed lex / policy.",
      "Base mix is EN + ZH + JA.",
      "When conjunctions or adverbs show up, inserting English often helps readability.",
      "Prefer shorter alphabet / cognate spellings when they align with meaning.",
      "Concrete lex mappings live under conventions[]; policy-only items have kind=policy.",
      "ℹ️ (information) stays on E MorphoZip etymon path, not this ledger.",
      "Furniture EN table → short JA/ZH desk lexeme (机 / 桌 / 桌子); canonical to=机; SQL/tech contexts keep table.",
      "Ambiguity gate (C): conjunction shortenings marked ambiguity_sensitive skip when short form already collides in-text, or prefer_precision=True (CLI --prefer-precision)."
    ]
  },
  "conventions": [
    {
      "id": "spatial-up-down-phrase",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "up and down",
        "above and below",
        "上下"
      ],
      "to": "上下",
      "rationale": "上下セットは短く視覚的に明確（1組で上下）"
    },
    {
      "id": "spatial-under",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "under",
        "below",
        "beneath"
      ],
      "to": "下",
      "rationale": "under/below は「下」1字で即座に分かる"
    },
    {
      "id": "spatial-above",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "above"
      ],
      "to": "上",
      "rationale": "under/below と対になる「上」"
    },
    {
      "id": "uneven-凹凸",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "デコボコ",
        "でこぼこ",
        "凸凹",
        "uneven",
        "bumpy"
      ],
      "to": "凹凸",
      "rationale": "凹凸は視覚的に分かりやすい"
    },
    {
      "id": "policy-base-mix",
      "kind": "policy",
      "apply_layer": "C",
      "rationale": "ベースは EN+ZH+JA。接続詞・副詞は英語挿入が効くことが多い。短いアルファベット/cognate スペルを優先。C 台帳に保持。実装は今後の具体マッピング追加時。",
      "payload": {
        "base_mix": [
          "en",
          "zh",
          "ja"
        ],
        "conjunction_adverb_bias": "en",
        "prefer_short_alphabet_cognates": true
      }
    },
    {
      "id": "spatial-left-right",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "left and right",
        "left or right",
        "左右"
      ],
      "to": "左右",
      "rationale": "左右は短く視覚的（左右セット）"
    },
    {
      "id": "spatial-front-back",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "front and back",
        "前後"
      ],
      "to": "前後",
      "rationale": "前後は視覚的に明確"
    },
    {
      "id": "spatial-in-out",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "inside and outside",
        "in and out",
        "内外"
      ],
      "to": "内外",
      "rationale": "内外は1組で明確"
    },
    {
      "id": "spatial-big-small",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "large and small",
        "big and small",
        "大小"
      ],
      "to": "大小",
      "rationale": "大小は短く対比が明確"
    },
    {
      "id": "conj-moreover",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "moreover",
        "furthermore",
        "in addition"
      ],
      "to": "also",
      "rationale": "接続・副詞は英語短形を挟む（also）",
      "ambiguity_sensitive": true
    },
    {
      "id": "conj-nevertheless",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "nevertheless",
        "nonetheless"
      ],
      "to": "but",
      "rationale": "逆接は英語短形 but",
      "ambiguity_sensitive": true
    },
    {
      "id": "conj-therefore",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "therefore",
        "consequently",
        "as a result"
      ],
      "to": "so",
      "rationale": "帰結は英語短形 so",
      "ambiguity_sensitive": true
    },
    {
      "id": "conj-for-example",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "for example",
        "for instance"
      ],
      "to": "e.g.",
      "rationale": "例示は e.g. の短いアルファベット形"
    },
    {
      "id": "conj-that-is",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "that is to say",
        "that is",
        "in other words"
      ],
      "to": "i.e.",
      "rationale": "言い換えは i.e.（短い cognate）"
    },
    {
      "id": "furniture-table",
      "kind": "lex",
      "apply_layer": "C",
      "from": [
        "tables",
        "table"
      ],
      "to": "机",
      "allowed_to": [
        "机",
        "桌",
        "桌子"
      ],
      "rationale": "EN table is polysemous (SQL/schema etc.). Furniture sense → short unambiguous desk/table lexeme in EN+ZH+JA bank: 机 (JA) or 桌/桌子 (ZH). Canonical to=机 (1 char); 桌 is an equally valid short target. Skip SQL/tech contexts.",
      "skip_sql_tech": true,
      "skip_near": [
        "sql",
        "select",
        "join",
        "schema",
        "database",
        "db",
        "varchar",
        "create",
        "drop",
        "alter",
        "insert",
        "update"
      ]
    }
  ]
}
