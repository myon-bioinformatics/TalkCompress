{"id": "tatoeba-14098726", "text": "Lui parla in francese con le sue insegnanti.", "lang": "it", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Guybrush88", "url": "https://tatoeba.org/sentences/show/14098726", "acquisition_source": "Tatoeba API unstable/sentences 2026-11-08"}
