{"id": "short-sw-0000", "lang": "sw", "category": "short", "text": "Mtu atampenda mwana.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0001", "lang": "sw", "category": "short", "text": "Heri ya mwaka mpya!", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0002", "lang": "sw", "category": "short", "text": "Nipe paspoti yako.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0003", "lang": "sw", "category": "short", "text": "Una mizigo zaidi?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0004", "lang": "sw", "category": "short", "text": "Saa ngapi ndege inaruka?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0005", "lang": "sw", "category": "short", "text": "Saa ngapi itabidi nifike kiwanjani?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0006", "lang": "sw", "category": "short", "text": "Umechelewa, ndege imeshaondoka.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0007", "lang": "sw", "category": "short", "text": "Asante sana", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0008", "lang": "sw", "category": "short", "text": "Ni raha kubwa.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0009", "lang": "sw", "category": "short", "text": "Ni raha!", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0010", "lang": "sw", "category": "short", "text": "Furaha ni yangu.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0011", "lang": "sw", "category": "short", "text": "Ni furaha yangu!", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0012", "lang": "sw", "category": "short", "text": "Jina langu ni Nuno kutoka Portugal, lakini ninaishi Rio.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0013", "lang": "sw", "category": "short", "text": "Unaongea Kireno?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0014", "lang": "sw", "category": "short", "text": "Jina langu ni Nuno kutoka Ureno lakini naishi Rio.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0015", "lang": "sw", "category": "short", "text": "Je, wewe umetoka Uholanzi?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0016", "lang": "sw", "category": "short", "text": "\"Habari yako?\"", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0017", "lang": "sw", "category": "short", "text": "\"Njema sana, nawe je?\"", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0018", "lang": "sw", "category": "short", "text": "\"Mzuri sana, asante.\"", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-sw-0019", "lang": "sw", "category": "short", "text": "Unaishi wapi?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
