{"id": "short-tr-0000", "lang": "tr", "category": "short", "text": "Dört silahlı adam bankayı soyup dört milyon dolarla kaçtı.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0001", "lang": "tr", "category": "short", "text": "Birçok insanın ölümü, sigara içilmesinden kaynaklanır.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0002", "lang": "tr", "category": "short", "text": "Öğleden sonra hava çok fırtınalıydı.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0003", "lang": "tr", "category": "short", "text": "Bana çekinmeden sordu.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0004", "lang": "tr", "category": "short", "text": "Vitrine bakmayı bıraktı.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0005", "lang": "tr", "category": "short", "text": "Bunu senin yerine yapmamı bekleme.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0006", "lang": "tr", "category": "short", "text": "O senin bebeğin.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0007", "lang": "tr", "category": "short", "text": "John G. Roberts, ABD Yüksek Mahkemesi Başyargıcıdır.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0008", "lang": "tr", "category": "short", "text": "Tom CD'lerini sanatçılarına göre düzenledi.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0009", "lang": "tr", "category": "short", "text": "Tom ceketinin cebinden bir el feneri çıkardı.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0010", "lang": "tr", "category": "short", "text": "Tom daha dün mevduat hesabına biraz para yatırdı.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0011", "lang": "tr", "category": "short", "text": "Al gülüm, ver gülüm.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0012", "lang": "tr", "category": "short", "text": "Sen aradığında biz de tam senden bahsediyorduk.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0013", "lang": "tr", "category": "short", "text": "Açlıktan kırılıyorum.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0014", "lang": "tr", "category": "short", "text": "Raporu yazdı.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0015", "lang": "tr", "category": "short", "text": "Tom işi karara bağladı.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0016", "lang": "tr", "category": "short", "text": "Eldiven giyiyor.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0017", "lang": "tr", "category": "short", "text": "Sadece sen bunu yapabilirsin.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0018", "lang": "tr", "category": "short", "text": "Japonya'ya yerleştiler.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-tr-0019", "lang": "tr", "category": "short", "text": "Ucuz kurtulduk.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
