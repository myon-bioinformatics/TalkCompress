{"id": "short-id-0000", "lang": "id", "category": "short", "text": "Jangan menebang pohon yang masih muda.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0001", "lang": "id", "category": "short", "text": "Kamu sudah mandi apa belum?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0002", "lang": "id", "category": "short", "text": "Ayah Tom adalah seorang polisi.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0003", "lang": "id", "category": "short", "text": "Apakah kamu di sana?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0004", "lang": "id", "category": "short", "text": "Apakah kamu di situ?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0005", "lang": "id", "category": "short", "text": "Kita tidak mengambil hikmah sama sekali.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0006", "lang": "id", "category": "short", "text": "Kami tidak mengambil hikmah sama sekali.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0007", "lang": "id", "category": "short", "text": "Kamu tampaknya belum tahu rasa dipatil lele.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0008", "lang": "id", "category": "short", "text": "Apakah Tom kidal?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0009", "lang": "id", "category": "short", "text": "Tom enggan melakukan itu.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0010", "lang": "id", "category": "short", "text": "Silakan lepas dan letakkan sepatu di rak sepatu.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0011", "lang": "id", "category": "short", "text": "Beritahu aku apa lagi yang terjadi.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0012", "lang": "id", "category": "short", "text": "Pastikan kamu tidak melukai dirimu sendiri.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0013", "lang": "id", "category": "short", "text": "Dia pulang.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0014", "lang": "id", "category": "short", "text": "Ia pulang.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0015", "lang": "id", "category": "short", "text": "Kenapa kamu tidak tanya sendiri ke dia?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0016", "lang": "id", "category": "short", "text": "Itu tampak mencurigakan bagiku.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0017", "lang": "id", "category": "short", "text": "Ia tegas.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0018", "lang": "id", "category": "short", "text": "Dia tegas.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-id-0019", "lang": "id", "category": "short", "text": "Mengapa tidak ada yang ingin kau sampaikan?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
