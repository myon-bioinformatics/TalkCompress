{"id": "short-vi-0000", "lang": "vi", "category": "short", "text": "Cô ấy đã từ chối nhận tiền.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0001", "lang": "vi", "category": "short", "text": "Chúc mẹ tròn con vuông.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0002", "lang": "vi", "category": "short", "text": "Bút sa gà chết.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
