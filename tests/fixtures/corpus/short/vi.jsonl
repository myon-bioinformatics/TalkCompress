{"id": "short-vi-0008", "lang": "vi", "category": "short", "text": "Đừng suy nghĩ quá nhiều nhé.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0009", "lang": "vi", "category": "short", "text": "Đời người còn dài mà.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0010", "lang": "vi", "category": "short", "text": "Đời còn dài mà.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0011", "lang": "vi", "category": "short", "text": "Chiếc váy này rất hợp với em.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0012", "lang": "vi", "category": "short", "text": "Chúng ta bắt đầu công việc ngay nào.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0013", "lang": "vi", "category": "short", "text": "Đây không phải lần đầu tiên tôi lái một chiếc xe thể thao.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0014", "lang": "vi", "category": "short", "text": "Họ không biết lái ô tô.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
