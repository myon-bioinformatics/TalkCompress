{"id": "short-vi-0005", "lang": "vi", "category": "short", "text": "Alo.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-vi-0006", "lang": "vi", "category": "short", "text": "Tôi là Ogawa.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
