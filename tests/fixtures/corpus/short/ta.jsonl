{"id": "short-ta-0000", "lang": "ta", "category": "short", "text": "நான் அவன்.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0001", "lang": "ta", "category": "short", "text": "நான் அவள்.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0002", "lang": "ta", "category": "short", "text": "நல்ல முயற்சி.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0003", "lang": "ta", "category": "short", "text": "அவர் யார்?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0004", "lang": "ta", "category": "short", "text": "அவர்கள் பல நாடுகளில் இருந்து வருகிறார்கள்.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0005", "lang": "ta", "category": "short", "text": "உங்கள் வயது என்ன?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0006", "lang": "ta", "category": "short", "text": "அவனுக்கு பத்து வயது.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0007", "lang": "ta", "category": "short", "text": "அவளுக்கு பத்து வயது.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0008", "lang": "ta", "category": "short", "text": "வளர்ச்சி முக்கியம்.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0009", "lang": "ta", "category": "short", "text": "மாம்பழத்தை எடு.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0010", "lang": "ta", "category": "short", "text": "வயசு ஆகது.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0011", "lang": "ta", "category": "short", "text": "உதவி செய்.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0012", "lang": "ta", "category": "short", "text": "தயவுசெய்து உதவுங்கள்.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0013", "lang": "ta", "category": "short", "text": "அவனை குத்து.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0014", "lang": "ta", "category": "short", "text": "அவளை குத்து.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0015", "lang": "ta", "category": "short", "text": "எப்போ நேரம் வரும்?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0016", "lang": "ta", "category": "short", "text": "அவன் போய்விட்டான்.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0017", "lang": "ta", "category": "short", "text": "அதற்கு இப்போது உதவி தேவை.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0018", "lang": "ta", "category": "short", "text": "நீங்கள் எத்தனை வருடங்கள் அங்கே இருந்தீர்கள்?", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
{"id": "short-ta-0019", "lang": "ta", "category": "short", "text": "நான் நாளைக்கு வரேன்.", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC-BY-2.0-FR"}
