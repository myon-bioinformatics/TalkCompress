{"id": "tatoeba:14042184", "text": "ホテルに行きたい。", "lang": "ja", "source": "tatoeba", "license": "CC BY 2.0 FR", "author": "CuteGirlLeia", "url": "https://tatoeba.org/sentences/show/14042184", "tier": "short"}
{"id": "tatoeba:14043454", "text": "この本はすごい。", "lang": "ja", "source": "tatoeba", "license": "CC BY 2.0 FR", "author": "CuteGirlLeia", "url": "https://tatoeba.org/sentences/show/14043454", "tier": "short"}
