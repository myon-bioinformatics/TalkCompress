{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TalkCompress 多言語テストコーパス manifest",
  "description": "正の検証は scripts/corpus_manifest.py（stdlib）。このファイルは参照用で、両者は tests/test_corpus_manifest.py で突き合わせる。 各 JSONL 行は tier（short/medium/long）を持つ。(category, lang, source) は一意。",
  "type": "object",
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "url",
          "license",
          "license_url",
          "lang",
          "category",
          "count",
          "bytes",
          "o200k_tokens",
          "sha256",
          "retrieved_at",
          "ai_roundtrip"
        ],
        "oneOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "fetch_url"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "enum": [
              "CC0 1.0",
              "Public domain",
              "CC BY 2.0 FR",
              "CC BY 3.0",
              "CC BY 4.0",
              "CC BY-SA 3.0",
              "CC BY-SA 4.0"
            ]
          },
          "license_url": {
            "type": "string",
            "minLength": 1
          },
          "lang": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "path": {
            "type": "string",
            "description": "corpus/ からの相対パス <category>/<lang>.jsonl"
          },
          "fetch_url": {
            "type": "string",
            "description": "外部取得元。scripts/corpus_fetch.py が sha256 を照合"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "o200k_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "ai_roundtrip": {
            "type": "string",
            "minLength": 1,
            "default": "未測定"
          },
          "attribution": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    }
  }
}