{"id": "tatoeba-en-0000", "text": "Please tell us where there is a grocery store.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0001", "text": "You should not give him up for lost.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0002", "text": "You are too critical of others' shortcomings.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0003", "text": "You would do well to tell it to him in advance.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0004", "text": "You are welcome to do anything you like.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0005", "text": "You are responsible for what you do.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0006", "text": "You are the wickedest witty person I know.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0007", "text": "You are the master of your own destiny.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0008", "text": "You are wearing your socks inside out.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0009", "text": "You must come back before nine o'clock.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0010", "text": "You had better not smoke while on duty.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0011", "text": "You are not entitled to attend the meeting.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0012", "text": "Do you love music?", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0013", "text": "You had better ask the doctor for advice.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0014", "text": "You are too ready to speak ill of others.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0015", "text": "You are old enough to stand on your own feet.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0016", "text": "You had better stay here a little longer.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0017", "text": "You are asking too much for this car.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0018", "text": "You are prohibited from smoking here.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba-en-0019", "text": "You had better get away from here at once.", "lang": "en", "tier": "short", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/", "acquisition_source": "OPUS-Tatoeba v2023-04-12 mono"}
{"id": "tatoeba:14098009", "text": "No one is cringe; people cringe at others, which is their own problem.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "rul", "url": "https://tatoeba.org/sentences/show/14098009", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098032", "text": "You can do it. I believe in you, my daughter.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098032", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098037", "text": "I cried for you. Now cry for me.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "carlosalberto", "url": "https://tatoeba.org/sentences/show/14098037", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098039", "text": "Sometimes, one has to listen to their heart.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098039", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098043", "text": "He's stolen my toys yet again!", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098043", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098047", "text": "I'll be there, I promise.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098047", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098051", "text": "He doesn't travel to Germany anymore? He has changed his mind?", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098051", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098055", "text": "Her friends are trying to console her.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098055", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098061", "text": "Can you talk with me briefly?", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098061", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098066", "text": "Maria and Hans want to break up. They no longer get with each other.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098066", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098070", "text": "A baby without his parents is helpless.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098070", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098076", "text": "After the appointment with the therapist, she now feels relieved.", "lang": "en", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Ioan_Cristian", "url": "https://tatoeba.org/sentences/show/14098076", "tier": "short", "acquisition_source": "Tatoeba API"}
