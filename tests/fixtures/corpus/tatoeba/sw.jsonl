{"id": "lowres-tatoeba-sw-0000", "text": "Mtu atampenda mwana.", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0001", "text": "Heri ya mwaka mpya!", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0002", "text": "Nipe paspoti yako.", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0003", "text": "Una mizigo zaidi?", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0004", "text": "Saa ngapi ndege inaruka?", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0005", "text": "Saa ngapi itabidi nifike kiwanjani?", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0006", "text": "Umechelewa, ndege imeshaondoka.", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0007", "text": "Asante sana", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0008", "text": "Ni raha kubwa.", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0009", "text": "Ni raha!", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0010", "text": "Furaha ni yangu.", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0011", "text": "Ni furaha yangu!", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0012", "text": "Jina langu ni Nuno kutoka Portugal, lakini ninaishi Rio.", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0013", "text": "Unaongea Kireno?", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0014", "text": "Jina langu ni Nuno kutoka Ureno lakini naishi Rio.", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0015", "text": "Je, wewe umetoka Uholanzi?", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0016", "text": "\"Habari yako?\"", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0017", "text": "\"Njema sana, nawe je?\"", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0018", "text": "\"Mzuri sana, asante.\"", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-sw-0019", "text": "Unaishi wapi?", "lang": "sw", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, swh)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
