{"id": "tatoeba:14096458", "text": "Je me suis hâtée pour partir, mais il m'a laissé tomber.", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "madjidoumnia", "url": "https://tatoeba.org/sentences/show/14096458", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14096530", "text": "La soie est chère.", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "twentyplus", "url": "https://tatoeba.org/sentences/show/14096530", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14096965", "text": "Il lève son bras.", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Jat01", "url": "https://tatoeba.org/sentences/show/14096965", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14096985", "text": "Il y a une rivière près de la maison.", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Jat01", "url": "https://tatoeba.org/sentences/show/14096985", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14097003", "text": "J'aime la démocratie.", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Adelpa", "url": "https://tatoeba.org/sentences/show/14097003", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14097945", "text": "Les plantes ont besoin de lumière et d'eau.", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Adelpa", "url": "https://tatoeba.org/sentences/show/14097945", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14097960", "text": "Qu'est-ce que la lumière ?", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Adelpa", "url": "https://tatoeba.org/sentences/show/14097960", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14097991", "text": "Je ne sais pas comment j'ai vécu sans ton amour. Aujourd'hui, je vis avec toi et je suis heureux. Je sais que sans toi, je ne pourrai pas vivre.", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "carlosalberto", "url": "https://tatoeba.org/sentences/show/14097991", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14097994", "text": "Quelle est la longueur d'onde de la lumière ?", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Adelpa", "url": "https://tatoeba.org/sentences/show/14097994", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14097997", "text": "Qu'est-ce que la longueur d'onde ?", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "Adelpa", "url": "https://tatoeba.org/sentences/show/14097997", "tier": "short", "acquisition_source": "Tatoeba API"}
{"id": "tatoeba:14098033", "text": "J'ai pleuré pour toi. Pleure maintenant pour moi.", "lang": "fr", "source": "Tatoeba", "license": "CC BY 2.0 FR", "author": "carlosalberto", "url": "https://tatoeba.org/sentences/show/14098033", "tier": "short", "acquisition_source": "Tatoeba API"}
