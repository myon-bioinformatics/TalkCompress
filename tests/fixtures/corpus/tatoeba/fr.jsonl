{"id": "tatoeba-fr-0000", "text": "Je n'ai pas fait la différence entre eux.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0001", "text": "Hamlet agit comme s'il était fou.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0002", "text": "Harry réussit à traverser la rivière à la nage.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0003", "text": "Hollywood n'est plus ce qu'il était.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0004", "text": "Le pain et le lait sont de bons aliments.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0005", "text": "Peter en avait assez des filles puériles.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0006", "text": "Les Beatles sont connus des jeunes gens.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0007", "text": "Il a dit qu'il souffrait d'un terrible mal de tête.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0008", "text": "Bill était en retard à l'école, comme d'habitude.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0009", "text": "Bill sait faire du vélo.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0010", "text": "Bill est joueur de baseball.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0011", "text": "Fabre a écrit des livres sur les insectes.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0012", "text": "Brian a acheté un rouge à lèvres pour Kate.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0013", "text": "Un plat en plastique fondra sur la cuisinière.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0014", "text": "Blue Sky Sport est fermé tous les jeudis.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0015", "text": "Fred passa toute la journée à chercher un travail.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0016", "text": "Fred a laissé une grande fortune à sa femme.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0017", "text": "Fred écrivit une longue lettre à sa mère.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0018", "text": "Les Bakers ont une ferme en amont de la rivière.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "tatoeba-fr-0019", "text": "Madame Baker s'est fait voler son porte-monnaie.", "lang": "fr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
