{"id": "lowres-tatoeba-tr-0000", "text": "Dört silahlı adam bankayı soyup dört milyon dolarla kaçtı.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0001", "text": "Birçok insanın ölümü, sigara içilmesinden kaynaklanır.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0002", "text": "Öğleden sonra hava çok fırtınalıydı.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0003", "text": "Bana çekinmeden sordu.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0004", "text": "Vitrine bakmayı bıraktı.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0005", "text": "Bunu senin yerine yapmamı bekleme.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0006", "text": "O senin bebeğin.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0007", "text": "John G. Roberts, ABD Yüksek Mahkemesi Başyargıcıdır.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0008", "text": "Tom CD'lerini sanatçılarına göre düzenledi.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0009", "text": "Tom ceketinin cebinden bir el feneri çıkardı.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0010", "text": "Tom daha dün mevduat hesabına biraz para yatırdı.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0011", "text": "Al gülüm, ver gülüm.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0012", "text": "Sen aradığında biz de tam senden bahsediyorduk.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0013", "text": "Açlıktan kırılıyorum.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0014", "text": "Raporu yazdı.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0015", "text": "Tom işi karara bağladı.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0016", "text": "Eldiven giyiyor.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0017", "text": "Sadece sen bunu yapabilirsin.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0018", "text": "Japonya'ya yerleştiler.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
{"id": "lowres-tatoeba-tr-0019", "text": "Ucuz kurtulduk.", "lang": "tr", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono, tr)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://opus.nlpl.eu/Tatoeba/"}
