{"id": "tatoeba-de-0000", "text": "„Was passiert in der Höhle?", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0001", "text": "Ich bin neugierig.“ – „Ich habe keine Ahnung.“", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0002", "text": "Maria interessiert sich für Politik.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0003", "text": "Harajuku ist eines der belebtesten Viertel Tokyos.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0004", "text": "Infolge einer Unfallverletzung konnte er nicht mehr gehen.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0005", "text": "Er hat Eier und Milch bei einem Bauern gekauft.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0006", "text": "Ich bin’s.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0007", "text": "Mein Hund wedelt mit dem Schwanz.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0008", "text": "Wir haben den ganzen Tag im Yoyogi-Park verbracht.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0009", "text": "Du kannst gehen, wenn du möchtest.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0010", "text": "Ich glaube, du hast recht.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0011", "text": "Sie ist nicht so jung, wie sie aussieht.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0012", "text": "Ein Mann weint nicht in der Öffentlichkeit.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0013", "text": "Er kommt zweimal pro Woche hierher.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0014", "text": "Ich renne, so schnell ich kann, um ihn einzuholen.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0015", "text": "Ich denke, dass sie kommen wird.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0016", "text": "Die Olympischen Spiele finden alle vier Jahre statt.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0017", "text": "Ich muss mich rasieren.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0018", "text": "Glaubst du wirklich an Gespenster?", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
{"id": "tatoeba-de-0019", "text": "Die hat Haare auf den Zähnen.", "lang": "de", "tier": "short", "source": "Tatoeba (OPUS-Tatoeba v2023-04-12 mono)", "license": "CC BY 2.0 FR", "author": "Tatoeba contributors", "url": "https://tatoeba.org/"}
